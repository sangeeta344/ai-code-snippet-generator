# -----------------------------------------------------------------------------
# CodeForge AI — Environment Configuration Example
# -----------------------------------------------------------------------------
# If no API key or local Ollama is configured, the application automatically
# runs in deterministic Demo Mode using the curated knowledge base and smart synthesizer.

# 1. Google Gemini API (Recommended - Free at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# 2. OpenAI / Compatible API Provider (Optional)
# OPENAI_API_KEY=your_openai_key_here
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# 3. Groq API Key (Optional - Free fast LLMs at https://console.groq.com)
# GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# 4. Local Ollama Integration (Optional)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder

# 5. Timeout Configuration (seconds)
# LLM_TIMEOUT=30
